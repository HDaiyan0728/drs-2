{
  "name": "data-reconciliation-studio",
  "version": "3.0.0",
  "private": true,
  "description": "Browser-based validation and reconciliation of Excel and CSV files, with confidence-aware column matching",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "test": "node --test tests/*.test.js",
    "benchmark": "node tests/benchmark.js",
    "benchmark:verbose": "node tests/benchmark.js --verbose",
    "build:standalone": "node scripts/build-standalone.js"
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "jsdom": "^24.1.3",
    "xlsx": "0.18.5"
  }
}
